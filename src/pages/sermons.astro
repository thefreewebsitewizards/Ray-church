---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Sermons - Chesaw Community Bible Church">
  <main class="w-full bg-background-light dark:bg-background-dark">
    <div class="layout-container flex flex-col items-center">
      <div class="px-4 py-12 md:px-20 lg:px-40 flex flex-1 justify-center w-full">
        <div class="layout-content-container flex flex-col max-w-[960px] flex-1 gap-12">
          <div class="text-center max-w-[720px] mx-auto">
            <h1 class="text-slate-900 dark:text-white tracking-tight text-4xl font-bold leading-tight md:text-5xl">Sermons</h1>
            <p class="mt-4 text-slate-600 dark:text-slate-300 text-base md:text-lg leading-relaxed">
              Revisit recent messages and follow along with scripture throughout the week.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-background-dark overflow-hidden shadow-sm">
              <div
                class="h-44 bg-cover bg-center"
                data-alt="Open Bible on a wooden table with soft light"
                style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuC4E6uUQzv2x2uQcx0E6Gvflf2lZZlqXgRkwpQwoU8l4SxHcAOsS3uT6wD6_EYc9Qb1gK4YhR2yB7p8TFKXyI5wTzB5H6Vvhv1qjKQfBndz4uAqJ1R0aD8g5rR9Pp1hfs9YbWQJQ2rC8u9wdZ0u1Y6v8f");'
              ></div>
              <div class="p-6 flex flex-col gap-4">
                <div>
                  <h3 class="text-slate-900 dark:text-white text-lg font-bold">Hope In Hard Seasons</h3>
                  <p class="mt-1 text-slate-500 dark:text-slate-400 text-sm">Psalm 23 • 35 min</p>
                </div>
                <div class="flex gap-3">
                  <a class="flex-1 inline-flex items-center justify-center rounded-lg h-10 bg-primary text-white text-sm font-bold hover:bg-primary/90 transition-colors" href="https://www.youtube.com" rel="noopener noreferrer" target="_blank">
                    Watch
                  </a>
                  <button class="flex-1 inline-flex items-center justify-center rounded-lg h-10 bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white text-sm font-bold hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors" data-nav="/contact?intent=sermon-notes" type="button">
                    Get Notes
                  </button>
                </div>
              </div>
            </div>

            <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-background-dark overflow-hidden shadow-sm">
              <div
                class="h-44 bg-cover bg-center"
                data-alt="People worshiping together with raised hands"
                style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuC7GdH7d4i3mQfKXq4u9O1wqVQJv2d7wV8uQYx7f7xC0oHc0Jtqv3rZpY9oJ0J2mKpY9oY0cYk");'
              ></div>
              <div class="p-6 flex flex-col gap-4">
                <div>
                  <h3 class="text-slate-900 dark:text-white text-lg font-bold">Walking In Community</h3>
                  <p class="mt-1 text-slate-500 dark:text-slate-400 text-sm">Acts 2:42-47 • 28 min</p>
                </div>
                <div class="flex gap-3">
                  <a class="flex-1 inline-flex items-center justify-center rounded-lg h-10 bg-primary text-white text-sm font-bold hover:bg-primary/90 transition-colors" href="https://www.youtube.com" rel="noopener noreferrer" target="_blank">
                    Watch
                  </a>
                  <button class="flex-1 inline-flex items-center justify-center rounded-lg h-10 bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white text-sm font-bold hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors" data-nav="/contact?intent=sermon-notes" type="button">
                    Get Notes
                  </button>
                </div>
              </div>
            </div>
          </div>

          <div class="rounded-2xl overflow-hidden bg-slate-50 dark:bg-slate-900/30 border border-slate-200 dark:border-slate-800 shadow-sm p-8 flex flex-col md:flex-row items-center justify-between gap-6">
            <div>
              <h2 class="text-slate-900 dark:text-white text-2xl font-bold leading-tight">Looking for an older message?</h2>
              <p class="mt-2 text-slate-600 dark:text-slate-300">Send us a note and we’ll help you find it.</p>
            </div>
            <button class="bg-primary text-white font-bold py-3 px-6 rounded-lg hover:bg-primary/90 transition-colors w-full md:w-auto" data-nav="/contact?intent=sermons" type="button">
              Contact Us
            </button>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script is:inline>
    document.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;
      const el = target.closest('[data-nav]');
      if (!el) return;
      const to = el.getAttribute('data-nav');
      if (!to) return;
      e.preventDefault();
      window.location.assign(to);
    });
  </script>
</SiteLayout>
