---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Giving Portal - Chesaw Community Bible Church">
  <main class="min-h-screen flex flex-col items-center justify-start py-10 px-4 sm:px-6 font-display text-[#0d121b] dark:text-white transition-colors duration-200">
    <div class="w-full max-w-[600px] text-center mb-8">
      <h1 class="text-3xl sm:text-4xl font-black text-[#0d121b] dark:text-white tracking-tight mb-3">Support Our Mission</h1>
      <p class="text-[#4c669a] dark:text-slate-400 text-base sm:text-lg leading-relaxed">
        Your generosity helps Chesaw Community Bible Church serve our community and share the message of hope.
      </p>
    </div>
    <div class="w-full max-w-[550px] bg-white dark:bg-[#1a2230] rounded-xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] dark:shadow-none border border-[#e7ebf3] dark:border-[#2a3447] overflow-hidden transition-colors duration-200">
      <div class="bg-[#F9FAF8] dark:bg-[#151b26] p-2 border-b border-[#e7ebf3] dark:border-[#2a3447]">
        <div class="flex h-12 w-full items-center justify-center rounded-lg bg-[#e7ebf3] dark:bg-[#2a3447]/50 p-1">
          <label class="group flex cursor-pointer h-full grow items-center justify-center overflow-hidden rounded-md transition-all has-[:checked]:bg-white dark:has-[:checked]:bg-[#1a2230] has-[:checked]:shadow-sm has-[:checked]:text-primary dark:has-[:checked]:text-blue-400 text-[#4c669a] dark:text-slate-400 text-sm font-semibold leading-normal">
            <span class="truncate">Give One-Time</span>
            <input checked="" class="invisible w-0 absolute" name="frequency" type="radio" value="One-time" />
          </label>
          <label class="group flex cursor-pointer h-full grow items-center justify-center overflow-hidden rounded-md transition-all has-[:checked]:bg-white dark:has-[:checked]:bg-[#1a2230] has-[:checked]:shadow-sm has-[:checked]:text-primary dark:has-[:checked]:text-blue-400 text-[#4c669a] dark:text-slate-400 text-sm font-semibold leading-normal">
            <span class="truncate flex items-center gap-1">
              Monthly Recurring
              <span class="material-symbols-outlined text-[16px]">autorenew</span>
            </span>
            <input class="invisible w-0 absolute" name="frequency" type="radio" value="Monthly Recurring" />
          </label>
        </div>
      </div>
      <form class="p-6 sm:p-8 flex flex-col gap-6" data-donation-form>
        <div>
          <label class="block text-[#0d121b] dark:text-white text-sm font-bold mb-3">Select Amount</label>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <button
              class="h-12 rounded-lg border border-[#e7ebf3] dark:border-[#2a3447] hover:border-primary/50 bg-transparent text-[#0d121b] dark:text-white font-medium transition-all hover:bg-[#F9FAF8] dark:hover:bg-background-dark/50 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
              data-amount="25"
              type="button"
            >
              $25
            </button>
            <button
              class="h-12 rounded-lg border-2 border-primary bg-primary/5 text-primary dark:text-blue-400 dark:border-blue-500 dark:bg-blue-500/10 font-bold transition-all focus:outline-none ring-0"
              data-amount="50"
              type="button"
            >
              $50
            </button>
            <button
              class="h-12 rounded-lg border border-[#e7ebf3] dark:border-[#2a3447] hover:border-primary/50 bg-transparent text-[#0d121b] dark:text-white font-medium transition-all hover:bg-[#F9FAF8] dark:hover:bg-background-dark/50 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
              data-amount="100"
              type="button"
            >
              $100
            </button>
            <button
              class="h-12 rounded-lg border border-[#e7ebf3] dark:border-[#2a3447] hover:border-primary/50 bg-transparent text-[#0d121b] dark:text-white font-medium transition-all hover:bg-[#F9FAF8] dark:hover:bg-background-dark/50 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
              data-amount="custom"
              type="button"
            >
              Custom
            </button>
          </div>
        </div>
        <div class="space-y-4">
          <div class="flex flex-col sm:flex-row gap-4">
            <div class="flex-1">
              <label class="block text-[#0d121b] dark:text-white text-sm font-medium mb-1.5">First Name</label>
              <input
                class="w-full rounded-lg border-[#e7ebf3] dark:border-[#2a3447] bg-[#F9FAF8] dark:bg-background-dark text-[#0d121b] dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent h-11 px-3 text-sm placeholder:text-[#4c669a]/50 dark:placeholder:text-slate-400/50 transition-all shadow-sm"
                name="firstName"
                placeholder="Jane"
                type="text"
              />
            </div>
            <div class="flex-1">
              <label class="block text-[#0d121b] dark:text-white text-sm font-medium mb-1.5">Last Name</label>
              <input
                class="w-full rounded-lg border-[#e7ebf3] dark:border-[#2a3447] bg-[#F9FAF8] dark:bg-background-dark text-[#0d121b] dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent h-11 px-3 text-sm placeholder:text-[#4c669a]/50 dark:placeholder:text-slate-400/50 transition-all shadow-sm"
                name="lastName"
                placeholder="Doe"
                type="text"
              />
            </div>
          </div>
          <div>
            <label class="block text-[#0d121b] dark:text-white text-sm font-medium mb-1.5">Email Address</label>
            <div class="relative">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[#4c669a] dark:text-slate-400">
                <span class="material-symbols-outlined text-[18px]">mail</span>
              </span>
              <input
                class="w-full rounded-lg border-[#e7ebf3] dark:border-[#2a3447] bg-[#F9FAF8] dark:bg-background-dark text-[#0d121b] dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent h-11 pl-10 pr-3 text-sm placeholder:text-[#4c669a]/50 dark:placeholder:text-slate-400/50 transition-all shadow-sm"
                name="email"
                placeholder="jane.doe@example.com"
                type="email"
              />
            </div>
          </div>
        </div>
        <div class="h-px bg-[#e7ebf3] dark:bg-[#2a3447] w-full"></div>
        <div class="space-y-4">
          <div class="flex items-center justify-between mb-1">
            <label class="block text-[#0d121b] dark:text-white text-sm font-medium">Payment Method</label>
            <div class="flex gap-2 opacity-60 grayscale">
              <div
                class="h-5 w-8 bg-gradient-to-br from-blue-600 to-blue-800 rounded flex items-center justify-center text-[8px] font-bold text-white tracking-tighter"
                data-alt="Visa Card Icon"
              >
                VISA
              </div>
              <div class="h-5 w-8 bg-gradient-to-br from-orange-500 to-red-600 rounded flex items-center justify-center relative overflow-hidden" data-alt="Mastercard Icon">
                <div class="absolute left-0 top-0 bottom-0 w-1/2 bg-white/20 rounded-full translate-x-1"></div>
              </div>
            </div>
          </div>
          <div>
            <div class="relative">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[#4c669a] dark:text-slate-400">
                <span class="material-symbols-outlined text-[18px]">credit_card</span>
              </span>
              <span class="absolute right-3 top-1/2 -translate-y-1/2 text-[#4c669a] dark:text-slate-400">
                <span class="material-symbols-outlined text-[16px]">lock</span>
              </span>
              <input
                class="w-full rounded-lg border-[#e7ebf3] dark:border-[#2a3447] bg-[#F9FAF8] dark:bg-background-dark text-[#0d121b] dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent h-11 pl-10 pr-9 text-sm placeholder:text-[#4c669a]/50 dark:placeholder:text-slate-400/50 transition-all shadow-sm"
                autocomplete="cc-number"
                inputmode="numeric"
                maxlength="19"
                name="cardNumber"
                placeholder="Card number"
                type="text"
              />
            </div>
          </div>
          <div class="flex gap-4">
            <div class="flex-1">
              <input
                class="w-full rounded-lg border-[#e7ebf3] dark:border-[#2a3447] bg-[#F9FAF8] dark:bg-background-dark text-[#0d121b] dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent h-11 px-3 text-sm placeholder:text-[#4c669a]/50 dark:placeholder:text-slate-400/50 transition-all shadow-sm text-center"
                autocomplete="cc-exp"
                inputmode="numeric"
                maxlength="5"
                name="expiry"
                placeholder="MM / YY"
                type="text"
              />
            </div>
            <div class="flex-1">
              <input
                class="w-full rounded-lg border-[#e7ebf3] dark:border-[#2a3447] bg-[#F9FAF8] dark:bg-background-dark text-[#0d121b] dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent h-11 px-3 text-sm placeholder:text-[#4c669a]/50 dark:placeholder:text-slate-400/50 transition-all shadow-sm text-center"
                autocomplete="cc-csc"
                inputmode="numeric"
                maxlength="4"
                name="cvc"
                placeholder="CVC"
                type="text"
              />
            </div>
          </div>
        </div>
        <button class="w-full bg-primary hover:bg-[#0a3690] text-white font-bold h-12 rounded-lg shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5 active:translate-y-0 mt-2 flex items-center justify-center gap-2 group" data-donation-submit type="submit">
          <span data-donation-submit-text>Process Donation of $50</span>
          <span class="material-symbols-outlined text-[20px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
        </button>
        <div class="hidden mt-3 rounded-lg border p-3 text-sm" data-donation-status></div>
        <div class="flex flex-col items-center gap-2 pt-2">
          <div class="flex items-center gap-1.5 text-[#4c669a]/70 dark:text-slate-400/70 text-xs font-medium">
            <span class="material-symbols-outlined text-[14px]">lock</span>
            <span>Your transaction is secure and encrypted.</span>
          </div>
          <div class="flex gap-4 items-center opacity-40 grayscale hover:grayscale-0 transition-all duration-300">
            <div class="h-6 flex items-center gap-1">
              <span class="material-symbols-outlined text-2xl">verified_user</span>
              <span class="text-xs font-bold font-sans">SECURE</span>
            </div>
            <div class="h-4 border-r border-[#4c669a]/30"></div>
            <div class="h-6 flex items-center gap-1">
              <span class="material-symbols-outlined text-2xl">shield</span>
              <span class="text-xs font-bold font-sans">ENCRYPTED</span>
            </div>
          </div>
        </div>
      </form>
    </div>
    <div class="mt-12 text-center text-[#4c669a] dark:text-slate-400/60 text-xs sm:text-sm">
      <p class="mb-2">
        Need help? Contact us at <a class="text-primary hover:underline font-medium" href="mailto:giving@chesawchurch.org">giving@chesawchurch.org</a>
      </p>
      <div class="flex justify-center gap-4">
        <a class="hover:text-[#0d121b] dark:hover:text-white transition-colors" href="/privacy">Privacy Policy</a>
        <span>•</span>
        <a class="hover:text-[#0d121b] dark:hover:text-white transition-colors" href="/terms">Terms of Service</a>
      </div>
      <p class="mt-4 text-xs opacity-50">© 2024 Chesaw Community Bible Church. All rights reserved.</p>
    </div>
  </main>

  <script is:inline>
    const validateEmail = (value) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);

    const formatCardNumber = (raw) => {
      const digits = raw.replace(/\D/g, '').slice(0, 16);
      const groups = digits.match(/.{1,4}/g) ?? [];
      return groups.join(' ');
    };

    const formatExpiry = (raw) => {
      const digits = raw.replace(/\D/g, '').slice(0, 4);
      const mm = digits.slice(0, 2);
      const yy = digits.slice(2, 4);
      if (digits.length <= 2) return mm;
      return `${mm} / ${yy}`;
    };

    const setStatus = (el, variant, message) => {
      if (!el) return;
      el.classList.remove('hidden');
      el.className =
        'mt-3 rounded-lg border p-3 text-sm ' +
        (variant === 'success'
          ? 'border-primary/30 bg-primary/5 text-[#0d121b] dark:text-white'
          : 'border-red-200 bg-red-50 text-red-800 dark:border-red-900/50 dark:bg-red-900/20 dark:text-red-200');
      el.textContent = message;
    };

    const clearStatus = (el) => {
      if (!el) return;
      el.className = 'hidden mt-3 rounded-lg border p-3 text-sm';
      el.textContent = '';
    };

    const donationForm = document.querySelector('[data-donation-form]');
    if (donationForm instanceof HTMLFormElement) {
      const amountButtons = Array.from(donationForm.querySelectorAll('button[data-amount]'));
      const submitText = donationForm.querySelector('[data-donation-submit-text]');
      const statusEl = donationForm.querySelector('[data-donation-status]');

      const anySelected = amountButtons.find((b) => b.className.includes('border-2'));
      const selectedClass = anySelected?.className ?? '';
      const anyUnselected = amountButtons.find((b) => !b.className.includes('border-2'));
      const unselectedClass = anyUnselected?.className ?? '';

      let amount = 50;

      const updateSubmitText = (value) => {
        if (!submitText) return;
        submitText.textContent = `Process Donation of $${value}`;
      };

      const setSelected = (button, newAmount) => {
        amountButtons.forEach((b) => {
          b.className = b === button ? selectedClass : unselectedClass;
        });
        amount = newAmount;
        updateSubmitText(amount);
      };

      amountButtons.forEach((button) => {
        button.addEventListener('click', () => {
          clearStatus(statusEl);
          const value = button.getAttribute('data-amount');
          if (value === 'custom') {
            const input = window.prompt('Enter a donation amount (USD):', amount.toString());
            const next = input ? Number(input.replace(/[^\d.]/g, '')) : NaN;
            if (!Number.isFinite(next) || next <= 0) {
              setStatus(statusEl, 'error', 'Please enter a valid donation amount.');
              return;
            }
            setSelected(button, Math.round(next * 100) / 100);
            return;
          }
          const next = Number(value);
          if (!Number.isFinite(next) || next <= 0) return;
          setSelected(button, next);
        });
      });

      const cardNumberInput = donationForm.elements.namedItem('cardNumber');
      if (cardNumberInput instanceof HTMLInputElement) {
        cardNumberInput.addEventListener('input', () => {
          const formatted = formatCardNumber(cardNumberInput.value);
          if (cardNumberInput.value !== formatted) cardNumberInput.value = formatted;
        });
      }

      const expiryInput = donationForm.elements.namedItem('expiry');
      if (expiryInput instanceof HTMLInputElement) {
        expiryInput.addEventListener('input', () => {
          const formatted = formatExpiry(expiryInput.value);
          if (expiryInput.value !== formatted) expiryInput.value = formatted;
        });
      }

      const cvcInput = donationForm.elements.namedItem('cvc');
      if (cvcInput instanceof HTMLInputElement) {
        cvcInput.addEventListener('input', () => {
          const digits = cvcInput.value.replace(/\D/g, '').slice(0, 4);
          if (cvcInput.value !== digits) cvcInput.value = digits;
        });
      }

      updateSubmitText(amount);

      let isSubmitting = false;
      donationForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (isSubmitting) return;

        clearStatus(statusEl);

        const firstName = (donationForm.elements.namedItem('firstName')?.value ?? '').toString().trim();
        const lastName = (donationForm.elements.namedItem('lastName')?.value ?? '').toString().trim();
        const email = (donationForm.elements.namedItem('email')?.value ?? '').toString().trim();
        const cardNumber = (donationForm.elements.namedItem('cardNumber')?.value ?? '').toString().trim().replace(/\s/g, '');
        const expiry = (donationForm.elements.namedItem('expiry')?.value ?? '').toString().trim();
        const cvc = (donationForm.elements.namedItem('cvc')?.value ?? '').toString().trim();

        const errors = [];
        if (!firstName) errors.push('Please enter your first name.');
        if (!lastName) errors.push('Please enter your last name.');
        if (!email) errors.push('Please enter your email address.');
        if (email && !validateEmail(email)) errors.push('Please enter a valid email address.');
        if (!cardNumber || cardNumber.length < 12) errors.push('Please enter a valid card number.');
        if (!expiry || expiry.replace(/\D/g, '').length < 4) errors.push('Please enter an expiry date.');
        if (!cvc || cvc.replace(/\D/g, '').length < 3) errors.push('Please enter a valid CVC.');

        if (errors.length > 0) {
          setStatus(statusEl, 'error', errors[0]);
          return;
        }

        const submitButton = donationForm.querySelector('[data-donation-submit]');
        const originalLabel = submitText?.textContent ?? '';

        isSubmitting = true;
        if (submitText) submitText.textContent = 'Processing...';
        if (submitButton instanceof HTMLButtonElement) submitButton.setAttribute('aria-disabled', 'true');

        const delay = 900 + Math.floor(Math.random() * 900);
        await new Promise((r) => setTimeout(r, delay));

        const didFail = Math.random() < 0.12;
        if (didFail) {
          setStatus(statusEl, 'error', 'Payment could not be processed. Please try again.');
        } else {
          setStatus(statusEl, 'success', `Thank you! Your $${amount} donation was received.`);
          donationForm.reset();
          if (submitText && originalLabel) submitText.textContent = originalLabel;
        }

        if (submitText && !didFail) updateSubmitText(amount);
        if (submitText && didFail && originalLabel) submitText.textContent = originalLabel;
        if (submitButton instanceof HTMLButtonElement) submitButton.removeAttribute('aria-disabled');
        isSubmitting = false;
      });
    }
  </script>
</SiteLayout>
