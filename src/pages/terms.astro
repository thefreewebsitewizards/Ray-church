---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Terms of Service - Chesaw Community Bible Church">
  <main class="w-full bg-background-light dark:bg-background-dark">
    <div class="layout-container flex flex-col items-center">
      <div class="px-4 py-12 md:px-20 lg:px-40 flex flex-1 justify-center w-full">
        <div class="layout-content-container flex flex-col max-w-[960px] flex-1 gap-10">
          <div class="text-center max-w-[720px] mx-auto">
            <h1 class="text-slate-900 dark:text-white tracking-tight text-4xl font-bold leading-tight md:text-5xl">Terms of Service</h1>
            <p class="mt-4 text-slate-600 dark:text-slate-300 text-base md:text-lg leading-relaxed">
              This page is provided for prototype purposes and will be finalized before launch.
            </p>
          </div>

          <div class="bg-white dark:bg-background-dark border border-slate-200 dark:border-slate-800 rounded-xl p-6 md:p-8 shadow-sm space-y-6">
            <div>
              <h2 class="text-slate-900 dark:text-white text-xl font-bold">Use Of This Site</h2>
              <p class="mt-2 text-slate-600 dark:text-slate-300">
                Content and interactions are intended for church communication and community engagement.
              </p>
            </div>
            <div>
              <h2 class="text-slate-900 dark:text-white text-xl font-bold">Giving</h2>
              <p class="mt-2 text-slate-600 dark:text-slate-300">
                Online giving interactions in this prototype are simulated for demonstration purposes.
              </p>
            </div>
            <div>
              <h2 class="text-slate-900 dark:text-white text-xl font-bold">Contact</h2>
              <p class="mt-2 text-slate-600 dark:text-slate-300">
                Questions can be sent to <a class="text-primary hover:underline font-medium" href="mailto:chesawcbc@gmail.com">chesawcbc@gmail.com</a>.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</SiteLayout>
