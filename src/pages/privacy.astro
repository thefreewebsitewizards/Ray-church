---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Privacy Policy - Chesaw Community Bible Church">
  <main class="w-full bg-background-light dark:bg-background-dark">
    <div class="layout-container flex flex-col items-center">
      <div class="px-4 py-12 md:px-20 lg:px-40 flex flex-1 justify-center w-full">
        <div class="layout-content-container flex flex-col max-w-[960px] flex-1 gap-10">
          <div class="text-center max-w-[720px] mx-auto">
            <h1 class="text-slate-900 dark:text-white tracking-tight text-4xl font-bold leading-tight md:text-5xl">Privacy Policy</h1>
            <p class="mt-4 text-slate-600 dark:text-slate-300 text-base md:text-lg leading-relaxed">
              This page is provided for prototype purposes and will be finalized before launch.
            </p>
          </div>

          <div class="bg-white dark:bg-background-dark border border-slate-200 dark:border-slate-800 rounded-xl p-6 md:p-8 shadow-sm space-y-6">
            <div>
              <h2 class="text-slate-900 dark:text-white text-xl font-bold">Information We Collect</h2>
              <p class="mt-2 text-slate-600 dark:text-slate-300">
                When you submit a form, we may collect your name, email address, and message content.
              </p>
            </div>
            <div>
              <h2 class="text-slate-900 dark:text-white text-xl font-bold">How We Use Information</h2>
              <p class="mt-2 text-slate-600 dark:text-slate-300">
                We use the information you provide to respond to requests, coordinate visits, and support church communication.
              </p>
            </div>
            <div>
              <h2 class="text-slate-900 dark:text-white text-xl font-bold">Contact</h2>
              <p class="mt-2 text-slate-600 dark:text-slate-300">
                Questions about privacy can be sent to <a class="text-primary hover:underline font-medium" href="mailto:info@chesawchurch.org">info@chesawchurch.org</a>.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</SiteLayout>
