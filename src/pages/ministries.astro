---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Ministries - Chesaw Community Bible Church">
  <main class="w-full bg-background-light dark:bg-background-dark">
    <div class="layout-container flex flex-col items-center">
      <div class="px-4 py-12 md:px-20 lg:px-40 flex flex-1 justify-center w-full">
        <div class="layout-content-container flex flex-col max-w-[960px] flex-1 gap-12">
          <div class="text-center max-w-[720px] mx-auto">
            <h1 class="text-slate-900 dark:text-white tracking-tight text-4xl font-bold leading-tight md:text-5xl">Ministries</h1>
            <p class="mt-4 text-slate-600 dark:text-slate-300 text-base md:text-lg leading-relaxed">
              Find a place to connect, grow, and serve alongside our church family.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="flex flex-col gap-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-background-dark p-6 hover:border-primary/50 transition-colors">
              <div class="text-primary p-3 bg-primary/10 rounded-lg w-fit">
                <span class="material-symbols-outlined" style="font-size: 32px;">family_restroom</span>
              </div>
              <div class="flex flex-col gap-2">
                <h3 class="text-slate-900 dark:text-white text-lg font-bold">Kids</h3>
                <p class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed">
                  Safe, fun, Bible-centered classes for children during Sunday services.
                </p>
              </div>
              <button class="mt-2 inline-flex items-center justify-center rounded-lg h-10 px-5 bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white text-sm font-bold hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors" data-nav="/contact?intent=kids" type="button">
                Get Info
              </button>
            </div>

            <div class="flex flex-col gap-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-background-dark p-6 hover:border-primary/50 transition-colors">
              <div class="text-primary p-3 bg-primary/10 rounded-lg w-fit">
                <span class="material-symbols-outlined" style="font-size: 32px;">groups</span>
              </div>
              <div class="flex flex-col gap-2">
                <h3 class="text-slate-900 dark:text-white text-lg font-bold">Small Groups</h3>
                <p class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed">
                  Meet midweek to pray, study scripture, and build lasting relationships.
                </p>
              </div>
              <button class="mt-2 inline-flex items-center justify-center rounded-lg h-10 px-5 bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white text-sm font-bold hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors" data-nav="/contact?intent=groups" type="button">
                Join A Group
              </button>
            </div>

            <div class="flex flex-col gap-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-background-dark p-6 hover:border-primary/50 transition-colors">
              <div class="text-primary p-3 bg-primary/10 rounded-lg w-fit">
                <span class="material-symbols-outlined" style="font-size: 32px;">volunteer_activism</span>
              </div>
              <div class="flex flex-col gap-2">
                <h3 class="text-slate-900 dark:text-white text-lg font-bold">Serve</h3>
                <p class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed">
                  Use your gifts to help the church and bless our community throughout the week.
                </p>
              </div>
              <button class="mt-2 inline-flex items-center justify-center rounded-lg h-10 px-5 bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white text-sm font-bold hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors" data-nav="/contact?intent=serve" type="button">
                Volunteer
              </button>
            </div>
          </div>

          <div class="rounded-2xl overflow-hidden bg-slate-50 dark:bg-slate-900/30 border border-slate-200 dark:border-slate-800 shadow-sm p-8 flex flex-col md:flex-row items-center justify-between gap-6">
            <div>
              <h2 class="text-slate-900 dark:text-white text-2xl font-bold leading-tight">Not sure where to start?</h2>
              <p class="mt-2 text-slate-600 dark:text-slate-300">
                Tell us what you're looking for and we'll help you find your next step.
              </p>
            </div>
            <button class="bg-primary text-white font-bold py-3 px-6 rounded-lg hover:bg-primary/90 transition-colors w-full md:w-auto" data-nav="/contact?intent=connect" type="button">
              Contact Us
            </button>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script is:inline>
    document.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;
      const el = target.closest('[data-nav]');
      if (!el) return;
      const to = el.getAttribute('data-nav');
      if (!to) return;
      e.preventDefault();
      window.location.assign(to);
    });
  </script>
</SiteLayout>
