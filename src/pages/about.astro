---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="About Us - Chesaw Community Bible Church">
  <div class="w-full">
    <div class="layout-container flex flex-col">
      <div class="px-4 py-6 md:px-20 lg:px-40 flex flex-1 justify-center">
        <div class="layout-content-container flex flex-col max-w-[960px] flex-1">
          <div class="@container">
            <div
              class="flex min-h-[480px] flex-col gap-6 bg-cover bg-center bg-no-repeat rounded-xl items-center justify-center p-8 text-center"
              data-alt="Group of diverse people laughing together outdoors in warm sunlight"
              style='background-image: linear-gradient(rgba(0, 0, 0, 0.4) 0%, rgba(0, 0, 0, 0.6) 100%), url("/Greenery-image.jpg");'
            >
              <div class="flex flex-col gap-4 max-w-[600px]">
                <h1 class="text-white text-4xl font-black leading-tight tracking-[-0.033em] md:text-5xl lg:text-6xl">Welcome Home</h1>
                <p class="text-slate-100 text-base font-medium leading-normal md:text-lg">
                  Welcome to Chesaw Community Bible Church! We’re here to serve you, whether you’re looking for a church home or have
                  questions about who Jesus Christ is.
                </p>
              </div>
              <button class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-12 px-6 bg-primary text-white text-base font-bold leading-normal tracking-[0.015em] hover:bg-primary/90 transition-all shadow-lg shadow-black/20" data-nav="/contact?intent=visit" type="button">
                <span class="truncate">Plan Your Visit</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="w-full bg-background-light dark:bg-background-dark">
    <div class="layout-container flex flex-col items-center">
      <div class="px-4 py-12 md:px-20 lg:px-40 flex flex-1 justify-center w-full">
        <div class="layout-content-container flex flex-col max-w-[960px] flex-1 gap-12">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
            <div class="flex flex-col gap-6">
              <div>
                <h2 class="text-primary text-sm font-bold uppercase tracking-wider mb-2">Our Story</h2>
                <h1 class="text-slate-900 dark:text-white tracking-tight text-3xl font-bold leading-tight md:text-4xl">
                  More Than Just A Building
                </h1>
              </div>
              <p class="text-slate-600 dark:text-slate-300 text-lg font-normal leading-relaxed">
                Our vision is to build a church community that is actively involved in leading the lost into a lifechanging relationship
                with Jesus Christ and involving them in a growing community of Christians who are corporately and individually worshipping God.
                We seek to build relationships through SHARING, COMMUNICATING, and CARING. We believe it is the only CHRIST-like way to truly
                Fellowship with one another.
              </p>
              <p class="text-slate-600 dark:text-slate-300 text-base font-normal leading-relaxed">
                Chesaw Community Bible Church is a place where people from all walks of life come together to worship, learn, and grow.
                Our church is committed to making a positive impact in the community and beyond.
              </p>
              <p class="text-slate-600 dark:text-slate-300 text-base font-normal leading-relaxed">
                It is our prayer and purpose to help people grow closer to Jesus Christ. If you are looking for a church home, or have
                questions about who Jesus Christ is, we want to serve you in any way we can.
              </p>
            </div>
            <div class="flex flex-col gap-4">
              <div
                class="w-full bg-center bg-no-repeat aspect-[4/3] bg-cover rounded-xl shadow-md"
                data-alt="People raising hands in worship inside a church"
                style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuDzY5UTPFeZq6eLmrKxWNlOVciSIb8dk9azKseQJba-fLKevWfdBMArzbtK4p7YT_F2PtQcFho1AdhIMf2J4HCtiwym1bMrJrkc-7oX05yEqho_VsYRcrme3FYznkbGfaQe8BVIlikldp8YcD2tkYx0F4I4ILg4BaNh97JuC7o5eFmEXbVHXb1bAhFCpY070auFjPdD5ypqbzsGgS2BDuTsefY55VO74ULUYAASBdQkwZ-doPEjHlo_Iu-HjV1nAkJNTnjRNTTzBQ");'
              ></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="w-full bg-white dark:bg-slate-900/50">
    <div class="layout-container flex flex-col items-center">
      <div class="px-4 py-16 md:px-20 lg:px-40 flex flex-1 justify-center w-full">
        <div class="layout-content-container flex flex-col max-w-[960px] flex-1 gap-10">
          <div class="text-center max-w-[720px] mx-auto">
            <h2 class="text-slate-900 dark:text-white text-3xl font-bold leading-tight mb-4">Our Core Values</h2>
            <p class="text-slate-500 dark:text-slate-400 text-base">What guides us in our daily walk and worship.</p>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
            <div class="flex flex-1 gap-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-background-light dark:bg-background-dark p-6 flex-col hover:border-primary/50 transition-colors group">
              <div class="text-primary p-3 bg-primary/10 rounded-lg w-fit group-hover:bg-primary group-hover:text-white transition-colors">
                <span class="material-symbols-outlined" style="font-size: 32px;">diversity_3</span>
              </div>
              <div class="flex flex-col gap-2">
                <h3 class="text-slate-900 dark:text-white text-lg font-bold">Community</h3>
                <p class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed">
                  Building lasting relationships through fellowship, small groups, and shared meals.
                </p>
              </div>
            </div>
            <div class="flex flex-1 gap-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-background-light dark:bg-background-dark p-6 flex-col hover:border-primary/50 transition-colors group">
              <div class="text-primary p-3 bg-primary/10 rounded-lg w-fit group-hover:bg-primary group-hover:text-white transition-colors">
                <span class="material-symbols-outlined" style="font-size: 32px;">queue_music</span>
              </div>
              <div class="flex flex-col gap-2">
                <h3 class="text-slate-900 dark:text-white text-lg font-bold">Worship</h3>
                <p class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed">
                  Honoring God through contemporary music, traditional hymns, and biblical teaching.
                </p>
              </div>
            </div>
            <div class="flex flex-1 gap-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-background-light dark:bg-background-dark p-6 flex-col hover:border-primary/50 transition-colors group">
              <div class="text-primary p-3 bg-primary/10 rounded-lg w-fit group-hover:bg-primary group-hover:text-white transition-colors">
                <span class="material-symbols-outlined" style="font-size: 32px;">volunteer_activism</span>
              </div>
              <div class="flex flex-col gap-2">
                <h3 class="text-slate-900 dark:text-white text-lg font-bold">Service</h3>
                <p class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed">
                  Serving our neighbors in Chesaw and beyond with open hearts and helpful hands.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="w-full">
    <div class="layout-container flex flex-col items-center">
      <div class="px-4 py-12 md:px-20 lg:px-40 flex flex-1 justify-center w-full">
        <div class="layout-content-container flex flex-col max-w-[960px] flex-1">
          <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 md:p-8 shadow-sm">
            <div class="flex flex-col md:flex-row gap-8 items-center md:items-start">
              <div class="shrink-0">
                <div
                  class="bg-center bg-no-repeat bg-cover rounded-xl w-32 h-32 md:w-48 md:h-48 shadow-inner"
                  data-alt="Portrait of a smiling middle-aged man wearing glasses"
                  style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuCfrWEWVdhONb-HZiu5Kq7XDBIKWC2QAuZg1640-91G3gXZbkGX0fpHOHqP7iZvjl3JpB9WIf3LJsWJkXpjsbV77zvBw0WQi8XbL-wx8uLEe7xr-i0HgjcvSvbYaQYDylZaU2tasz3UEx1Kj1ZcN3P1DbLrdpZawPEFV2W53KWxB34GQUF_7eqDfSjRzUabWvC1Gd2UOTKNqFIVVBOYOd_leS5bFmj51T5dgSNHk7EY7JON96E1B6S9pTu8xac8VBKMNFQ14mgAXg");'
                ></div>
              </div>
              <div class="flex flex-col gap-4 flex-1 text-center md:text-left">
                <div>
                  <h3 class="text-slate-900 dark:text-white text-2xl font-bold leading-tight">Meet Pastor Ray Leggett</h3>
                  <p class="text-primary font-medium">Senior Pastor</p>
                </div>
                <p class="text-slate-600 dark:text-slate-300 text-base leading-relaxed">
                  Ray and Cheri have been in ministry for over 21 years, with experience in church planting and rural churches.
                  In Christ, Ray Leggett — Ph: 509-201-9490.
                </p>
                <div class="pt-2">
                  <button class="inline-flex cursor-pointer items-center justify-center rounded-lg h-10 px-6 bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white text-sm font-bold hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors" data-nav="/contact?intent=pastor" type="button">
                    Contact Pastor Ray
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="w-full bg-slate-50 dark:bg-slate-900/30">
    <div class="layout-container flex flex-col items-center">
      <div class="px-4 py-16 md:px-20 lg:px-40 flex flex-1 justify-center w-full">
        <div class="layout-content-container flex flex-col max-w-[960px] flex-1 gap-10">
          <div class="flex flex-col md:flex-row gap-8 rounded-2xl overflow-hidden bg-background-light dark:bg-background-dark border border-slate-200 dark:border-slate-800 shadow-lg">
            <div class="flex-1 p-8 flex flex-col justify-center gap-8">
              <div>
                <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-2">Join Us This Sunday</h2>
                <p class="text-slate-500 dark:text-slate-400">We can't wait to meet you.</p>
              </div>
              <div class="space-y-6">
                <div class="flex gap-4 items-start">
                  <div class="text-primary mt-1">
                    <span class="material-symbols-outlined">schedule</span>
                  </div>
                  <div>
                    <h3 class="font-bold text-slate-900 dark:text-white text-lg">Service Times</h3>
                    <p class="text-slate-600 dark:text-slate-300">Meeting Time</p>
                    <p class="text-slate-600 dark:text-slate-300">Sundays at 10:30 AM</p>
                  </div>
                </div>
                <div class="flex gap-4 items-start">
                  <div class="text-primary mt-1">
                    <span class="material-symbols-outlined">location_on</span>
                  </div>
                  <div>
                    <h3 class="font-bold text-slate-900 dark:text-white text-lg">Location</h3>
                    <p class="text-slate-600 dark:text-slate-300">123 Faith Lane</p>
                    <p class="text-slate-600 dark:text-slate-300">Chesaw, WA 98844</p>
                  </div>
                </div>
              </div>
              <button class="w-full md:w-auto mt-2 bg-primary text-white font-bold py-3 px-6 rounded-lg hover:bg-primary/90 transition-colors flex items-center justify-center gap-2" data-nav="https://www.google.com/maps/dir/?api=1&destination=123%20Faith%20Lane%2C%20Chesaw%2C%20WA%2098844" type="button">
                <span class="material-symbols-outlined text-[20px]">map</span>
                Get Directions
              </button>
            </div>
            <div class="flex-1 min-h-[300px] bg-slate-200 relative">
              <div
                class="absolute inset-0 bg-cover bg-center"
                data-alt="Map showing the location of the church in Chesaw"
                data-location="Chesaw, Washington"
                style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuAG5dEoDV5dteXW7h5WP2GZDy4N-PKYo4jm2VseBdK5jvGn2Pxf7Act7jifKdEXfRRR7U9LeO0Hp1agsvIJvVgVHxK96xRGt1fCEf3HPfFob4dRPhqLtwtSPqPE8RPHNv6j5PSDsVJxtjlvKaaxyJCi78Wo89J0fscuqF83-PHXr4AWQPtZTieRP6LHRW8BWDAOQO3DHe0Uizj2INUWTsUqT6tb--Y9ejienUsmS1hJJZOaxrBcMByx5EyF0bP3Uf_qh-ITxdjqig");'
              ></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;
      const el = target.closest('[data-nav]');
      if (!el) return;
      const to = el.getAttribute('data-nav');
      if (!to) return;
      e.preventDefault();
      window.location.assign(to);
    });
  </script>
</SiteLayout>
