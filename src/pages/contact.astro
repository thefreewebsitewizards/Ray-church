---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Contact - Chesaw Community Bible Church">
  <main class="w-full bg-background-light dark:bg-background-dark">
    <div class="layout-container flex flex-col items-center">
      <div class="px-4 py-12 md:px-20 lg:px-40 flex flex-1 justify-center w-full">
        <div class="layout-content-container flex flex-col max-w-[960px] flex-1 gap-12">
          <div class="text-center max-w-[720px] mx-auto">
            <h1 class="text-slate-900 dark:text-white tracking-tight text-4xl font-bold leading-tight md:text-5xl">Contact</h1>
            <p class="mt-4 text-slate-600 dark:text-slate-300 text-base md:text-lg leading-relaxed">
              We’d love to hear from you. Send a message and we’ll follow up soon.
            </p>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
            <div class="lg:col-span-2">
              <div class="bg-white dark:bg-[#1a2230] rounded-xl shadow-sm border border-[#e7ebf3] dark:border-[#2a3447] overflow-hidden">
                <div class="p-6 sm:p-8 flex flex-col gap-6">
                  <form data-contact-form>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                      <div>
                        <label class="block text-[#0d121b] dark:text-white text-sm font-medium mb-1.5">First Name</label>
                        <input class="w-full rounded-lg border-[#e7ebf3] dark:border-[#2a3447] bg-[#F9FAF8] dark:bg-background-dark text-[#0d121b] dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent h-11 px-3 text-sm transition-all shadow-sm" name="firstName" placeholder="Jane" type="text" />
                      </div>
                      <div>
                        <label class="block text-[#0d121b] dark:text-white text-sm font-medium mb-1.5">Last Name</label>
                        <input class="w-full rounded-lg border-[#e7ebf3] dark:border-[#2a3447] bg-[#F9FAF8] dark:bg-background-dark text-[#0d121b] dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent h-11 px-3 text-sm transition-all shadow-sm" name="lastName" placeholder="Doe" type="text" />
                      </div>
                    </div>

                    <div class="mt-4">
                      <label class="block text-[#0d121b] dark:text-white text-sm font-medium mb-1.5">Email Address</label>
                      <div class="relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[#4c669a] dark:text-slate-400">
                          <span class="material-symbols-outlined text-[18px]">mail</span>
                        </span>
                        <input class="w-full rounded-lg border-[#e7ebf3] dark:border-[#2a3447] bg-[#F9FAF8] dark:bg-background-dark text-[#0d121b] dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent h-11 pl-10 pr-3 text-sm transition-all shadow-sm" name="email" placeholder="jane.doe@example.com" type="email" />
                      </div>
                    </div>

                    <div class="mt-4">
                      <label class="block text-[#0d121b] dark:text-white text-sm font-medium mb-1.5">How can we help?</label>
                      <select class="w-full rounded-lg border-[#e7ebf3] dark:border-[#2a3447] bg-[#F9FAF8] dark:bg-background-dark text-[#0d121b] dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent h-11 px-3 text-sm transition-all shadow-sm" name="intent">
                        <option value="general">General question</option>
                        <option value="visit">Plan a visit</option>
                        <option value="pastor">Talk to Pastor Ray</option>
                        <option value="groups">Small groups</option>
                        <option value="serve">Serving / volunteering</option>
                        <option value="kids">Kids ministry</option>
                        <option value="sermons">Sermons</option>
                        <option value="sermon-notes">Sermon notes</option>
                      </select>
                    </div>

                    <div class="mt-4">
                      <label class="block text-[#0d121b] dark:text-white text-sm font-medium mb-1.5">Message</label>
                      <textarea class="w-full rounded-lg border-[#e7ebf3] dark:border-[#2a3447] bg-[#F9FAF8] dark:bg-background-dark text-[#0d121b] dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent min-h-[140px] px-3 py-2.5 text-sm transition-all shadow-sm resize-y" name="message" placeholder="Tell us a little more..." rows="5"></textarea>
                    </div>

                    <div class="mt-6">
                      <button class="w-full bg-primary hover:bg-[#0a3690] text-white font-bold h-12 rounded-lg shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5 active:translate-y-0 flex items-center justify-center gap-2 group" type="submit">
                        <span>Send Message</span>
                        <span class="material-symbols-outlined text-[20px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
                      </button>
                    </div>

                    <div class="mt-4 hidden" data-contact-status></div>
                  </form>
                </div>
              </div>
            </div>

            <div class="space-y-6">
              <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-background-dark p-6">
                <h2 class="text-slate-900 dark:text-white text-lg font-bold">Visit Us</h2>
                <p class="mt-3 text-slate-600 dark:text-slate-300 text-sm">
                  123 Faith Lane<br />Chesaw, WA 98844
                </p>
                <button class="mt-4 w-full bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white font-bold py-3 px-6 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors flex items-center justify-center gap-2" data-nav="https://www.google.com/maps/dir/?api=1&destination=123%20Faith%20Lane%2C%20Chesaw%2C%20WA%2098844" type="button">
                  <span class="material-symbols-outlined text-[20px]">map</span>
                  Get Directions
                </button>
              </div>

              <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-background-dark p-6">
                <h2 class="text-slate-900 dark:text-white text-lg font-bold">Call</h2>
                <p class="mt-3 text-slate-600 dark:text-slate-300 text-sm">(555) 123-4567</p>
              </div>

              <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-background-dark p-6">
                <h2 class="text-slate-900 dark:text-white text-lg font-bold">Email</h2>
                <p class="mt-3 text-slate-600 dark:text-slate-300 text-sm">
                  <a class="text-primary hover:underline font-medium" href="mailto:info@chesawchurch.org">info@chesawchurch.org</a>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script is:inline>
    const params = new URLSearchParams(window.location.search);
    const intent = params.get('intent');
    let isSubmitting = false;

    const validateEmail = (value) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);

    const setStatus = (el, variant, message) => {
      if (!el) return;
      el.classList.remove('hidden');
      el.className =
        'mt-4 rounded-lg border p-3 text-sm ' +
        (variant === 'success'
          ? 'border-primary/30 bg-primary/5 text-[#0d121b] dark:text-white'
          : 'border-red-200 bg-red-50 text-red-800 dark:border-red-900/50 dark:bg-red-900/20 dark:text-red-200');
      el.textContent = message;
    };

    const clearStatus = (el) => {
      if (!el) return;
      el.className = 'mt-4 hidden';
      el.textContent = '';
    };

    if (intent) {
      const form = document.querySelector('[data-contact-form]');
      const select = form?.querySelector('select[name="intent"]');
      if (select instanceof HTMLSelectElement) {
        const option = Array.from(select.options).find((o) => o.value === intent);
        if (option) select.value = intent;
      }
    }

    document.querySelector('[data-contact-form]')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (isSubmitting) return;
      const form = e.currentTarget;
      if (!(form instanceof HTMLFormElement)) return;

      const statusEl = form.querySelector('[data-contact-status]');
      clearStatus(statusEl);

      const firstName = (form.elements.namedItem('firstName')?.value ?? '').toString().trim();
      const lastName = (form.elements.namedItem('lastName')?.value ?? '').toString().trim();
      const email = (form.elements.namedItem('email')?.value ?? '').toString().trim();
      const message = (form.elements.namedItem('message')?.value ?? '').toString().trim();

      const errors = [];
      if (!firstName) errors.push('Please enter your first name.');
      if (!lastName) errors.push('Please enter your last name.');
      if (!email) errors.push('Please enter your email address.');
      if (email && !validateEmail(email)) errors.push('Please enter a valid email address.');
      if (!message) errors.push('Please enter a message.');

      if (errors.length > 0) {
        setStatus(statusEl, 'error', errors[0]);
        return;
      }

      const submitButton = form.querySelector('button[type="submit"]');
      const submitText = submitButton?.querySelector('span');
      const originalText = submitText?.textContent ?? 'Send Message';

      isSubmitting = true;
      if (submitText) submitText.textContent = 'Sending...';
      if (submitButton instanceof HTMLButtonElement) submitButton.setAttribute('aria-disabled', 'true');

      const delay = 900 + Math.floor(Math.random() * 800);
      await new Promise((r) => setTimeout(r, delay));

      const didFail = Math.random() < 0.15;
      if (didFail) {
        setStatus(statusEl, 'error', 'Something went wrong. Please try again in a moment.');
      } else {
        setStatus(statusEl, 'success', 'Message sent! Thanks for reaching out — we’ll follow up soon.');
        form.reset();
        if (intent) {
          const select = form.querySelector('select[name="intent"]');
          if (select instanceof HTMLSelectElement) select.value = intent;
        }
      }

      if (submitText) submitText.textContent = originalText;
      if (submitButton instanceof HTMLButtonElement) submitButton.removeAttribute('aria-disabled');
      isSubmitting = false;
    });

    document.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;
      const el = target.closest('[data-nav]');
      if (!el) return;
      const to = el.getAttribute('data-nav');
      if (!to) return;
      e.preventDefault();
      window.location.assign(to);
    });
  </script>
</SiteLayout>
